{
  "name": "@andreas/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "start": "node --env-file=.env dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "scrape": "tsx --env-file=.env src/scripts/run-scraper.ts"
  },
  "dependencies": {
    "@andreas/shared": "workspace:*",
    "@better-auth/expo": "^1.6.9",
    "@expo-google-fonts/archivo": "^0.4.2",
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neondatabase/serverless": "^0.10.4",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^10.53.1",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "expo-server-sdk": "^6.1.0",
    "hono": "^4.6.14",
    "playwright": "^1.59.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode-generator": "^2.0.4",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  }
}
