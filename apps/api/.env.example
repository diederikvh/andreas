# Neon Postgres (Frankfurt). Use the pooled connection string.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# better-auth
BETTER_AUTH_SECRET=  # 32+ chars, use: openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:8787

# MessageBird (Bird) — leave the access key empty during local dev to log
# OTPs to the console instead of sending real SMS.
MESSAGEBIRD_ACCESS_KEY=
MESSAGEBIRD_ORIGINATOR=Andreas

# Bunny.net storage (used by future media-upload routes)
BUNNY_STORAGE_ZONE=andreas-x
BUNNY_STORAGE_PASSWORD=
BUNNY_PULL_ZONE_URL=https://andreas-x.b-cdn.net

PORT=8787
NODE_ENV=development
