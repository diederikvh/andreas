{
  "expo": {
    "name": "andreas",
    "slug": "andreas",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icons/ios/nacht/icon-appstore-1024.png",
    "scheme": "andreas",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "amsterdam.andreas.app",
      "associatedDomains": [
        "applinks:andreas.amsterdam"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "nl",
          "en"
        ]
      }
    },
    "locales": {
      "nl": "./locales/nl.json",
      "en": "./locales/en.json"
    },
    "android": {
      "package": "amsterdam.andreas.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0b",
        "foregroundImage": "./assets/icons/android/nacht/adaptive/foreground.png",
        "backgroundImage": "./assets/icons/android/nacht/adaptive/background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "andreas.amsterdam",
              "pathPrefix": "/e"
            },
            {
              "scheme": "https",
              "host": "andreas.amsterdam",
              "pathPrefix": "/v"
            },
            {
              "scheme": "https",
              "host": "andreas.amsterdam",
              "pathPrefix": "/u"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-android-lint-config.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/nacht/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0b",
          "dark": {
            "image": "./assets/splash/nacht/splash-icon.png",
            "backgroundColor": "#0a0a0b"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Andreas gebruikt je locatie alleen om events op de kaart in de buurt te tonen.",
          "locationWhenInUsePermission": "Andreas gebruikt je locatie alleen om events op de kaart in de buurt te tonen."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Andreas heeft toegang tot je foto's nodig om een profielfoto te kiezen."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Andreas gebruikt de camera alleen om een vriend-QR te scannen.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#caff00"
        }
      ],
      "expo-localization",
      "@maplibre/maplibre-react-native",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "andreas_amsterdam",
          "organization": "pluvo-bv"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bd092e0d-3947-4492-838d-1a7460aecd9d"
      }
    },
    "owner": "diederikvh",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bd092e0d-3947-4492-838d-1a7460aecd9d"
    }
  }
}
